# Copy this file to .env and update the URL for your machine.
#
# Android emulator can usually reach your host machine through:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api/v1
#
# iOS simulator can usually use:
# EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
#
# Physical devices need your computer's LAN IP, for example:
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000/api/v1

EXPO_PUBLIC_API_URL=http://YOUR_MACHINE_IP:YOUR_API_PORT/api/v1
